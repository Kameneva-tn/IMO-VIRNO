[Unit]
Description=IMO VIRNO — приймання замовлень із сайту
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/www/imo-virno
EnvironmentFile=/var/www/imo-virno/.env
ExecStart=/var/www/imo-virno/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8085
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
